[Unit]
Description=Photo Gallery - Next.js Application
Documentation=https://github.com/frostiks777/1pgWebGallery
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
# Deploy writes the built standalone bundle to release/ and wipes it clean
# on every deploy (rsync --delete) — nothing that must survive a deploy
# (config, caches) lives inside it. See DEPLOYMENT.md §10.
WorkingDirectory=/var/www/apps/photo-gallery/release

# Окружение
Environment="NODE_ENV=production"
Environment="PORT=3000"
# Kept outside release/ (which gets wiped on every deploy) so the
# thumbnail/dir-meta cache survives across deploys.
Environment="CACHE_DIR=/var/www/apps/photo-gallery/.data"
# 4096 was sized for the build step, which no longer runs on this box.
# The standalone runtime server barely needs heap; cap it well below this
# box's ~800MB RAM so a traffic/thumbnail spike can't push it into OOM.
Environment="NODE_OPTIONS=--max-old-space-size=512"
EnvironmentFile=/var/www/apps/photo-gallery/.env.local

# Запускаем собранный standalone-бандл напрямую через node — сборка
# (next build) больше не выполняется на этой машине вообще, её делает
# GitHub Actions на своих раннерах и присылает сюда готовый server.js
# (см. .github/workflows/deploy.yml и DEPLOYMENT.md §10).
ExecStart=/usr/bin/node server.js

# Перезапуск при падении
Restart=on-failure
RestartSec=10

# Таймауты
TimeoutStartSec=60
TimeoutStopSec=30

# Логирование
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=photo-gallery

# Ограничения ресурсов
LimitNOFILE=65535

# Безопасность
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
