# Photo Gallery — environment template
# Copy to .env.local and fill in. Every variable the app reads is listed here;
# the table in README.md documents the same set with defaults.
#
# With no WEBDAV_* set the app runs in demo mode on the bundled photos in
# public/demo-photos/ — useful for a quick look and for the e2e smoke tests.

# ─── WebDAV connection ───────────────────────────────────────────────────────
# Leave these empty to keep demo mode.

# Full WebDAV endpoint, including the trailing slash.
# Nextcloud: https://cloud.example.com/remote.php/dav/files/USER/
# ownCloud:  https://cloud.example.com/remote.php/dav/files/USER/
# Yandex:    https://webdav.yandex.com/
# Box:       https://dav.box.com/dav/
WEBDAV_URL=

WEBDAV_USERNAME=

# Prefer an app-specific password over your account password.
WEBDAV_PASSWORD=

# Folder inside the WebDAV account that holds the photos. Default: /Photos
PHOTOS_DIR=/Photos

# ─── Gallery access ──────────────────────────────────────────────────────────

# Password gate in front of the gallery. Empty → gallery is open.
# A successful login sets an httpOnly `gallery-auth` cookie for 30 days, shared
# across all tabs of the browser. To revoke access, clear the cookie or change
# this password.
WEBDAV_LOGON_PASSWORD=

# ─── Thumbnails and caching ──────────────────────────────────────────────────

# Write generated thumbnails into a .thumbs/ folder next to the photos on WebDAV,
# so they follow a backup or another client. Set to false to keep them local only.
# Default: true
WEBDAV_COLOCATED_CACHE=true

# Name of that co-located folder. Default: .thumbs
COLOCATED_THUMBS_DIR=.thumbs

# Local disk directory for thumbnails and per-folder settings.
# Default: <cwd>/.data
#
# ⚠️ This directory is STATE, not a scratch cache. Besides thumbnails it holds
# .data/dir-meta/<folder>.json — your hidden photos, panorama marks and folder
# covers. Deleting it resets the gallery to its defaults. On the production
# server it must live OUTSIDE the deploy directory so `rsync --delete` cannot
# wipe it.
CACHE_DIR=

# ─── Video ───────────────────────────────────────────────────────────────────

# Skip poster-frame extraction for videos larger than this many megabytes, so a
# big file cannot stall a 1-core server. Default: 300
# This caps poster generation only — playback is not limited by it.
VIDEO_PREVIEW_MAX_MB=300

# ─── API protection (src/proxy.ts) ───────────────────────────────────────────
# Both apply to every /api/* route. Leave the token empty on a private network
# and keep the API open.

# Require `Authorization: Bearer <token>` on API requests. Empty → auth off.
API_SECRET_TOKEN=

# In-memory rate limit per IP. Default: 3000
API_RATE_LIMIT=3000

# Rate-limit window in milliseconds. Default: 60000 (1 minute)
API_RATE_WINDOW=60000

# How many distinct IPs the limiter keeps before sweeping the entries whose
# window has already rolled over. Bounds memory on a server that is never
# restarted. Default: 10000
API_RATE_MAP_MAX=10000