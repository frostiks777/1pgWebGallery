{
  "$schema": "https://opencode.ai/config.json",

  // Плагины. Локальный telegram-autostart из .opencode/plugins/ opencode
  // подхватывает сам, перечислять его не нужно.
  //
  // opencode-notify (нативные уведомления ОС с кнопками Accept/Reject) убран
  // 2026-10-15: последняя версия 0.3.1 вышла 2026-02-03 и осталась v1-плагином,
  // а v1-плагины в opencode 2 не грузятся ("Expected object at [\"default\"]").
  // Второй канал — Telegram-мост, см. .agents/skills/telegram-bridge/SKILL.md;
  // ручной тост без opencode — scripts/notify.ps1.

  // Главная модель основного агента — только для локальных сессий.
  //
  // В CI модель другая и приходит из переменной репозитория `OPENCODE_MODEL`
  // с префиксом `openrouter/`: OpenCode-консоль недоступна, бесплатные модели
  // `opencode/*` шлюз отдаёт только самому OpenCode (остальным 401/403), а
  // бесплатный тир Google AI Studio даёт flash-моделям 20 запросов в сутки —
  // агентская сессия в это не влезает и выедает лимит за один прогон.
  // Провайдер CI — OpenRouter (`OPENROUTER_API_KEY`), причина — ADR 0004.
  //
  // Бесплатные модели opencode отключаются и блокируются по IP — это
  // регулярное событие, а не разовая поломка. Рабочие на 2026-10-19
  // (проверены `opencode run -m`):
  //   opencode/mimo-v2.6-flash-free
  //   opencode/nemotron-3.5-lightning-free
  //   opencode/nemotron-3-ultra-free
  // Внезапно исчезнувшая: opencode/muse-spark-1.3-contributor-free.
  "model": "opencode/mimo-v2.6-flash-free",

  // Модель субагентам здесь НЕ задаётся: без неё субагент наследует модель
  // родительской сессии, а она в CI приходит из переменной OPENCODE_MODEL.
  // Закреплённая модель провайдера в этом файле пережила бы смену провайдера и
  // уронила бы прогон: `-m google/...` не спасает от пина `opencode/...` внутри
  // субагента. Локально субагенты работают на `model` выше.
  "agents": {
    // Исследовательский субагент: только чтение и веб. Нет edit/bash/task,
    // чтобы случайно ничего не править.
    "explore": {
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny"
      }
    }
  },

  // MCP-серверы. Подключён официальный shadcn MCP — в этом репозитории
  // components.json есть, UI-компоненты в src/components/ui/ (Radix/shadcn).
  //
  // ВАЖНО: npm-пакет называется `shadcn`, сервер запускается подкомандой `mcp`.
  // Имя `@shadcn/ui/mcp` невалидно (npm: EINVALIDPACKAGENAME) — из-за него
  // процесс падал с "MCP error -32000: Connection closed".
  //
  // Запуск только через `bunx`, не `npx`: в package.json стоит
  // devEngines.packageManager = bun с onFail: "error", поэтому npm (в том числе
  // npx) отказывается работать в этом каталоге — сервер падал с EBADDEVENGINES
  // "Invalid name \"bun\" does not match \"npm\"" и MCP оставался отключённым.
  // Проверка: `bunx shadcn@latest mcp --help`
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": ["bunx", "shadcn@latest", "mcp"],
      "enabled": true,
      "timeout": 60000
    }
  }
}
