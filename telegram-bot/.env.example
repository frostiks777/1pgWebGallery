# Токен от @BotFather (никому не показывать, в git не коммитить)
TELEGRAM_BOT_TOKEN=
# Твой числовой chat_id (whitelist: чужие чаты бот игнорирует)
TELEGRAM_ALLOWED_CHAT_ID=

# Локальный прокси, если api.telegram.org напрямую не открывается (в РФ TLS не проходит,
# прямой `curl` отдаёт 000). Пример: http://127.0.0.1:10809 — HTTP-инбаунд xray.
# Пусто — ходить напрямую. Скрипты перезапускают себя с HTTP(S)_PROXY и
# NODE_USE_ENV_PROXY=1 (Node 24+), см. proxy.mjs.
TELEGRAM_PROXY=

# Автоуведомления от opencode: on — писать в TG, когда агент закончил (session.idle) или упал;
# off — только ручные вызовы notify.mjs/reply.mjs.
